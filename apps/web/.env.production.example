# Production build config for the VPS deploy (Vite reads .env.production for `vite build`).
# Copy to apps/web/.env.production and fill in. This file is the documented template;
# .env.production itself is gitignored (operational config, kept local).

# Xtream server the player logs in against (public CDN gateway).
VITE_XTREAM_SERVER=https://gw.castcdn.net:443

# Keep empty for the EXYU 100-user pilot: API and media go directly from
# gw.castcdn.net/edge hosts to the viewer. This avoids relaying 300-500 Mbps of
# video through the small Lumen VPS. Live CORS was verified for
# https://player.exyu.tv on 2026-07-10.
VITE_XTREAM_PROXY_ORIGIN=

# Server beacon sink for client playback telemetry. Points at the proxy /observe
# endpoint. Empty disables beaconing (console-only). Used for live diagnosis.
VITE_OBSERVABILITY_BEACON_URL=https://player.exyu.tv/observe

# Google Cast custom receiver id. Leave empty until the prod App ID is registered.
VITE_GOOGLE_CAST_APP_ID=

# Catch-up MP2->AAC shadow hosts. edge6 is where EXYU archives live and where
# timeshift_shadow.php (A/V-normalizing fMP4 remux) runs; gw is the public
# gateway the player logs in against (302 -> edge6). List both so the tokenized
# shadow rewrite fires on either the pre- or post-redirect host.
VITE_CATCHUP_SHADOW_HOSTS=edge6.castcdn.net,gw.castcdn.net

# Enable shadow catch-up (A/V-normalized minute boundaries). Best-effort: if the
# shadow can't be resolved it falls back to the legacy timeshift.php path.
VITE_CATCHUP_SHADOW_VALIDATION=1

# Client-side catch-up PTS rebase (browser remux-free timeline stitching).
# Takes precedence over the shadow attempt when enabled. The viewer device
# rewrites PTS/DTS/PCR; the Lumen VPS does not transcode or remux media.
VITE_CATCHUP_CLIENT_REBASE=1

# Hard-disable same-origin catch-up gateway auto-routing for the 100-user
# pilot. Client-rebase and provider shadow traffic must stay device -> CDN.
VITE_CATCHUP_GATEWAY_ENABLED=0
