# Xtream Codes IPTV Server Configuration
# Set this to your IPTV server URL
# Users will only need to enter their username and password

# Example: http://iptv.example.com:8080 or https://iptv.example.com
VITE_XTREAM_SERVER=http://your-iptv-server.com:8080

# Google Cast custom receiver id. Required outside dev when Cast is in scope.
VITE_GOOGLE_CAST_APP_ID=

# Catch-up MP2->AAC shadow endpoint (timeshift_shadow.php) host routing.
# Comma-separated list of recording hosts whose tokenized catch-up requests
# should be routed to the shadow endpoint. Leave empty to keep the default
# validation host only. Add real recording hosts here as the shadow is
# deployed/verified per host (no code change needed).
# Example: oveu.mediaking.fi,serv2.mediaking.fi
VITE_CATCHUP_SHADOW_HOSTS=
