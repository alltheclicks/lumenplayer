    "release:evidence-links:test": "vitest run scripts/release/validate-release-evidence-links.test.ts",
    "release:secret-hygiene:validate": "node scripts/release/validate-release-secret-hygiene.mjs",
    "release:secret-hygiene:test": "vitest run scripts/release/validate-release-secret-hygiene.test.ts",
    "release:qaf035:validate": "node scripts/release/validate-qaf035-release-gates.mjs",
    "release:qaf035:final": "node scripts/release/validate-qaf035-release-gates.mjs --require-final",
    "release:qaf035:test": "vitest run scripts/release/validate-qaf035-release-gates.test.ts",
    "release:guardrails:test": "vitest run scripts/release",
    "release:no-media-evidence:scan": "node scripts/release/validate-no-media-processing-evidence.mjs",
    "release:no-media-evidence:test": "vitest run scripts/release/validate-no-media-processing-evidence.test.ts",
    "release:no-media-scan-artifact:validate": "node scripts/release/validate-no-media-evidence-scan-artifact.mjs artifacts/release/media-policy/qaf035-no-media-evidence-scan-20260602.json",
    "release:no-media-scan-artifact:test": "vitest run scripts/release/validate-no-media-evidence-scan-artifact.test.ts",
    "release:proxy-no-media:validate": "node scripts/release/validate-proxy-no-media-runtime.mjs",
    "release:proxy-no-media:test": "vitest run apps/proxy/src/catchup-remux.test.ts apps/proxy/src/catchup-gateway.test.ts apps/proxy/src/server.test.ts",
    "release:cast-readiness:validate": "node scripts/release/validate-google-cast-readiness.mjs",
    "release:cast-readiness:test": "vitest run scripts/release/validate-google-cast-readiness.test.ts",
    "release:pwa-readiness:validate": "node scripts/release/validate-pwa-readiness.mjs",
    "release:pwa-readiness:test": "vitest run scripts/release/validate-pwa-readiness.test.ts",
    "e2e:qa:simulate": "node scripts/playwright/run-qa-user-sim.mjs",
    "e2e:provider:preflight": "node scripts/playwright/run-provider-qa-preflight.mjs",
    "e2e:playback:focused": "node scripts/playwright/run-focused-playback-smoke.mjs",
    "e2e:mobile:layout": "node scripts/playwright/run-mobile-layout-smoke.mjs",
    "e2e:design:captures": "node scripts/playwright/run-design-parity-captures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=8.0.0 <8.18.0": "8.20.0",
      "bn.js@>=4.0.0 <4.12.3": "4.12.5",
      "fast-uri@<3.1.2": "3.1.3",
      "postcss@<8.5.10": "8.5.10"
    }
  }
}
