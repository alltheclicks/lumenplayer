    "tasks:batch": "bash scripts/automation/batch-run.sh",
    "tasks:overlap": "bash scripts/automation/check-overlap.sh",
    "tasks:merge": "bash scripts/automation/merge-queue.sh",
    "tasks:docs-sync": "bash scripts/automation/docs-sync.sh",
    "release:perf-evidence:validate": "node scripts/release/validate-performance-evidence.mjs artifacts/release/performance/qaf035-performance-evidence-20260603.json",
