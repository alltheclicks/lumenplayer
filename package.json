{
  "name": "lumen-player",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "perf:ttfc": "vitest run scripts/perf/time-to-first-channel.test.ts",
    "perf:rss": "vitest run scripts/perf/memory-cap.test.ts",
    "release:go-no-go:validate": "node scripts/release/validate-go-no-go.mjs scripts/release/v1-go-no-go.template.json",
    "release:smoke-matrix:validate": "node scripts/release/validate-smoke-regression-matrix.mjs scripts/release/v1-smoke-regression-matrix.template.json",
    "release:smoke-matrix:test": "vitest run scripts/release/v1-smoke-regression-matrix.test.ts",
    "release:compat-matrix": "node scripts/release/compatibility-matrix-task.mjs",
    "release:compat-matrix:test": "vitest run scripts/release/compatibility-matrix-task.test.ts",
    "catchup:timeshift-hls:probe": "node scripts/catchup/probe-timeshift-hls.mjs",
    "catchup:timeshift-hls:test": "vitest run scripts/catchup/probe-timeshift-hls.test.ts",
    "clean": "turbo clean",
    "tasks:run": "bash scripts/automation/run-task.sh",
    "tasks:batch": "bash scripts/automation/batch-run.sh",
    "tasks:overlap": "bash scripts/automation/check-overlap.sh",
    "tasks:merge": "bash scripts/automation/merge-queue.sh",
    "tasks:docs-sync": "bash scripts/automation/docs-sync.sh",
    "release:perf-evidence:validate": "node scripts/release/validate-performance-evidence.mjs scripts/release/v1-performance-evidence.template.json",
    "release:perf-evidence:test": "vitest run scripts/release/v1-performance-evidence.test.ts",
    "release:beta-capacity:validate": "node scripts/release/validate-beta-capacity-evidence.mjs scripts/release/v1-beta-capacity-evidence.template.json",
    "release:beta-capacity:test": "vitest run scripts/release/v1-beta-capacity-evidence.test.ts",
    "release:runtime-media:validate": "node scripts/release/validate-runtime-media-policy.mjs scripts/release/v1-runtime-media-policy.template.json",
    "release:runtime-media:test": "vitest run scripts/release/v1-runtime-media-policy.test.ts",
    "release:manual-device-qa:validate": "node scripts/release/validate-manual-device-qa.mjs scripts/release/v1-manual-device-qa.template.json",
    "release:manual-device-qa:test": "vitest run scripts/release/v1-manual-device-qa.test.ts",
    "release:beta-ops:validate": "node scripts/release/validate-beta-ops-signoff.mjs scripts/release/v1-beta-ops-signoff.template.json",
    "release:beta-ops:test": "vitest run scripts/release/v1-beta-ops-signoff.test.ts",
    "release:provider-owner:validate": "node scripts/release/validate-provider-owner-signoff.mjs scripts/release/v1-provider-owner-signoff.template.json",
    "release:provider-owner:test": "vitest run scripts/release/v1-provider-owner-signoff.test.ts",
    "release:design-parity:validate": "node scripts/release/validate-design-parity-evidence.mjs scripts/release/v1-design-parity-evidence.template.json",
    "release:design-parity:test": "vitest run scripts/release/v1-design-parity-evidence.test.ts",
    "release:observability:test": "vitest run apps/web/src/services/observability.test.ts",
    "release:security-baseline:validate": "node scripts/release/validate-security-privacy-baseline.mjs scripts/release/v1-security-privacy-baseline.template.json",
    "release:security-baseline:test": "vitest run scripts/release/v1-security-privacy-baseline.test.ts",
    "release:readiness:validate": "node scripts/release/validate-release-readiness.mjs scripts/release/v1-release-readiness-review.template.json",
    "release:readiness:test": "vitest run scripts/release/v1-release-readiness-review.test.ts",
    "e2e:qa:simulate": "node scripts/playwright/run-qa-user-sim.mjs",
    "e2e:provider:preflight": "node scripts/playwright/run-provider-qa-preflight.mjs",
    "e2e:playback:focused": "node scripts/playwright/run-focused-playback-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
