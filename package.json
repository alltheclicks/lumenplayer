    "release:manual-device-qa:validate": "node scripts/release/validate-manual-device-qa.mjs artifacts/release/manual-device-qa/qaf035-manual-device-qa-20260603.json",
    "release:manual-device-qa:test": "vitest run scripts/release/v1-manual-device-qa.test.ts",
    "release:beta-ops:validate": "node scripts/release/validate-beta-ops-signoff.mjs artifacts/release/ops/qaf035-beta-ops-signoff-20260603.json",
    "release:beta-ops:test": "vitest run scripts/release/v1-beta-ops-signoff.test.ts",
    "release:provider-owner:validate": "node scripts/release/validate-provider-owner-signoff.mjs artifacts/release/provider/qaf035-provider-owner-signoff-20260603.json",
    "release:provider-owner:test": "vitest run scripts/release/v1-provider-owner-signoff.test.ts",
    "release:design-parity:validate": "node scripts/release/validate-design-parity-evidence.mjs artifacts/release/design/qaf035-design-parity-20260603.json",
    "release:design-parity:test": "vitest run scripts/release/v1-design-parity-evidence.test.ts",
    "release:observability:test": "vitest run apps/web/src/services/observability.test.ts",
    "release:observability-baseline:validate": "node scripts/release/validate-observability-baseline.mjs artifacts/release/observability/qaf035-observability-baseline-20260603.json",
    "release:observability-baseline:test": "vitest run scripts/release/v1-observability-baseline.test.ts",
