{
  "name": "lumen-player",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "security:audit:prod": "pnpm audit --prod --audit-level=moderate",
    "perf:ttfc": "vitest run scripts/perf/time-to-first-channel.test.ts",
    "perf:rss": "vitest run scripts/perf/memory-cap.test.ts",
    "perf:staging-capacity": "node scripts/perf/run-staging-capacity-smoke.mjs",
    "release:go-no-go:validate": "node scripts/release/validate-go-no-go.mjs artifacts/release/readiness/qaf035-go-no-go-20260603.json",
    "release:go-no-go:test": "vitest run scripts/release/v1-go-no-go.test.ts",
    "release:smoke-matrix:validate": "node scripts/release/validate-smoke-regression-matrix.mjs artifacts/release/smoke/qaf035-smoke-regression-matrix-20260603.json",
    "release:smoke-matrix:test": "vitest run scripts/release/v1-smoke-regression-matrix.test.ts",
