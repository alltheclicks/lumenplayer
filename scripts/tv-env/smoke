#!/usr/bin/env bash
# Disposable offline toolchain exercise, not a Klaro client or installable release.
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
sdk_root="${KLARO_TV_SDK_ROOT:-$HOME/.local/share/klaro-tv-sdk}"
sample_root="$(mktemp -d "$sdk_root/smoke.XXXXXXXX")"
printf 'Sample directory: %s\n' "$sample_root"
mkdir -p "$sample_root/lg-out" "$sample_root/android/classes" "$sample_root/android/dex" "$sample_root/tizen"
"$here/run" ares-generate -t basic -p id=com.example.tvtoolchainsmoke -p title='Toolchain smoke only' -p version=1.0.0 "$sample_root/lg"
python3 - "$sample_root/lg/appinfo.json" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
info = json.loads(p.read_text())
info['requiredACG'] = []
p.write_text(json.dumps(info, indent=2) + '\n')
PY
"$here/run" ares-package "$sample_root/lg" -o "$sample_root/lg-out"
cat > "$sample_root/android/MainActivity.java" <<'JAVA'
package com.example.tvtoolchainsmoke;
public final class MainActivity extends android.app.Activity {
  @Override public void onCreate(android.os.Bundle state) {
    super.onCreate(state);
    android.widget.TextView text = new android.widget.TextView(this);
    text.setText("SDK smoke sample only - not Klaro Player");
    setContentView(text);
  }
}
JAVA
cat > "$sample_root/android/AndroidManifest.xml" <<'XML'
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.tvtoolchainsmoke" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="28"/>
  <uses-feature android:name="android.software.leanback" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <application android:label="SDK smoke only" android:hasCode="true">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
XML
android_jar="$sdk_root/android/platforms/android-36/android.jar"
"$here/run" javac -source 8 -target 8 -bootclasspath "$android_jar" -d "$sample_root/android/classes" "$sample_root/android/MainActivity.java"
"$here/run" jar cf "$sample_root/android/classes.jar" -C "$sample_root/android/classes" .
"$here/run" d8 --lib "$android_jar" --min-api 25 --output "$sample_root/android/dex" "$sample_root/android/classes.jar"
"$here/run" aapt2 link -I "$android_jar" --manifest "$sample_root/android/AndroidManifest.xml" -o "$sample_root/android/base.apk"
python3 - "$sample_root/android" <<'PY'
import pathlib, sys, zipfile
p = pathlib.Path(sys.argv[1])
with zipfile.ZipFile(p / 'base.apk', 'a') as apk:
    apk.write(p / 'dex/classes.dex', 'classes.dex')
PY
"$here/run" zipalign -f 4 "$sample_root/android/base.apk" "$sample_root/android/smoke-unsigned.apk"
"$here/run" zipalign -c 4 "$sample_root/android/smoke-unsigned.apk"
"$here/run" aapt2 dump badging "$sample_root/android/smoke-unsigned.apk"
if "$here/run" apksigner verify "$sample_root/android/smoke-unsigned.apk" > "$sample_root/android/signature-check.log" 2>&1; then
  echo 'Unexpected signed Android sample' >&2
  exit 1
fi
rg -q 'Missing META-INF/MANIFEST.MF' "$sample_root/android/signature-check.log"
cat > "$sample_root/tizen/config.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://example.com/tvtoolchainsmoke" version="1.0.0" viewmodes="maximized">
  <tizen:application id="SmokeTv001.Smoke" package="SmokeTv001" required_version="5.0"/>
  <content src="index.html"/><name>SDK smoke only</name><tizen:profile name="tv-samsung"/>
</widget>
XML
printf '%s\n' '<!doctype html><title>SDK smoke only</title><p>Toolchain sample only - not Klaro Player</p>' > "$sample_root/tizen/index.html"
"$here/run" tizen build-web -- "$sample_root/tizen"
"$here/run" tizen package -t wgt -- "$sample_root/tizen/.buildResult"
python3 - "$sample_root" <<'PY'
import pathlib, sys, zipfile
root = pathlib.Path(sys.argv[1])
for p in root.rglob('*.wgt'):
    with zipfile.ZipFile(p) as z:
        assert 'config.xml' in z.namelist() and 'index.html' in z.namelist()
        print('WGT entries:', ', '.join(z.namelist()))
        print('Signed:', 'author-signature.xml' in z.namelist())
for pattern in ('*.ipk', '*unsigned.apk', '*.wgt'):
    matches = list(root.rglob(pattern))
    assert matches, 'Missing sample artifact: ' + pattern
    for p in matches:
        print(p.relative_to(root), p.stat().st_size, 'bytes')
PY
printf '\nSamples retained at %s; no install, emulator or device connection. Android unsigned; WGT uses SDK test certificates only.\n' "$sample_root"
