# Lumen proxy runtime for the player.exyu.tv DNS-only V1 pilot.
# Copy to /opt/lumen/proxy/proxy.env on the VPS; do not add credentials here.
HOST=127.0.0.1
PORT=8788
XTREAM_PROXY_ALLOWED_HOSTS=gw.castcdn.net
XTREAM_PROXY_ALLOWED_CORS_ORIGINS=https://player.exyu.tv
LUMEN_TRUST_PROXY_HOPS=1
LUMEN_OBSERVE_BODY_LIMIT_BYTES=16384
LUMEN_OBSERVE_MAX_EVENTS_PER_REQUEST=10
LUMEN_OBSERVE_RATE_LIMIT_PER_MINUTE=120
LUMEN_CATCHUP_GATEWAY_ENABLED=0
LUMEN_PROXY_REMUX_ENABLED=0
# exyu.tv SSO hand-off. 64 hex chars (openssl rand -hex 32); MUST match
# PLAYER_SSO_SECRET in the exyu.tv site environment. Unset => /sso/exchange
# stays disabled (404).
PLAYER_SSO_SECRET=
LUMEN_SSO_RATE_LIMIT_PER_MINUTE=10
